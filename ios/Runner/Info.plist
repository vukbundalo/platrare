	     The "Strip Debug-Only Info.plist Keys" build phase removes them from Release. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_dartVmService._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Used to take photos of receipts and attach them to transactions.</string>
