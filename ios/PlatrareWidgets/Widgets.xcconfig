// Inherit FLUTTER_BUILD_NAME / FLUTTER_BUILD_NUMBER so the appex version
// strings match the host app. App Store validation rejects an extension whose
// CFBundleShortVersionString / CFBundleVersion differ from the containing app.
//
// Everything else Generated.xcconfig defines (FLUTTER_ROOT, DART_DEFINES,
// EXCLUDED_ARCHS, PACKAGE_CONFIG, ...) is inert for an app extension.
// This file is regenerated by `flutter pub get`; the Runner target already
// hard-depends on it, so this adds no new clean-checkout constraint.
#include "../Flutter/Generated.xcconfig"
