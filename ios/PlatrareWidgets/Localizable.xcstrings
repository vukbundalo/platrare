    "widget.numbers.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض رقمًا واحدًا: المتاح للإنفاق أو صافي الثروة أو أدنى نقطة هذا الشهر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikažite jedan broj: raspoloživo, neto vrijednost ili najnižu tačku ovog mjeseca."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kennzahl anzeigen: verfügbar, Nettovermögen oder dein Tiefstand im Monat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show one figure: spendable, net worth, or your lowest point this month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una cifra: disponible, patrimonio neto o tu punto más bajo del mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez un chiffre : disponible, patrimoine net ou votre point le plus bas du mois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक आँकड़ा दिखाएँ: उपलब्ध, कुल संपत्ति, या इस महीने का न्यूनतम बिंदु।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikažite jedan broj: raspoloživo, neto vrijednost ili najnižu točku ovog mjeseca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un dato: disponibile, patrimonio netto o il punto più basso del mese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使える額・純資産・今月の最低残高から 1 つを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가용 금액, 순자산, 이번 달 최저점 중 하나를 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon één getal: besteedbaar, nettowaarde of je laagste punt deze maand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż jedną liczbę: dostępne środki, wartość netto lub najniższy punkt w tym miesiącu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostre um número: disponível, patrimônio líquido ou seu ponto mais baixo do mês."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostre um número: disponível, património líquido ou o seu ponto mais baixo do mês."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покажите одну цифру: доступно, чистые активы или минимум за месяц."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
